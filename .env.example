# --- AI provider: set ONE key. If only GEMINI_API_KEY is set, Gemini is used automatically. ---
# Free Gemini key: https://aistudio.google.com/apikey
# Note: on Gemini's free tier Google may use what you send (questions + student answers) to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# low | medium | high | xhigh for gemini-4-hydrogen (leave empty for the model default)
GEMINI_THINKING_LEVEL=medium

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Where quiz questions come from:
#   bank (default) = data/question-bank.txt, the AI only grades -> 1 AI call per attempt
#   ai             = the AI writes new questions every attempt -> 2 AI calls per attempt
QUESTION_SOURCE=bank

# Dry-run questions on the student's own code: how many per attempt (0 = off). Each one is 1 extra AI call.
CODE_QUESTIONS=1
# practice = students must paste their solution for each practice problem before the quiz; none = optional
REQUIRE_CODE=practice

# Force a provider: gemini | claude (optional)
# AI_PROVIDER=gemini

# 'demo' = templated questions + length-based grading, for trying the flow without any key
# AI_MODE=demo

# Strict proctoring
QUIZ_REQUIRE_CAMERA=true
QUIZ_MAX_STRIKES=3

PORT=3000
QUIZ_QUESTIONS=3
QUIZ_MINUTES=15
QUIZ_MAX_ATTEMPTS=3
QUIZ_PASS_PCT=50
# Set to false to let students take the quiz without supervisor approval of the day's plan
REQUIRE_SUPERVISOR_APPROVAL=true

# --- Deployment security ---
# Secure cookies + HSTS are on automatically when NODE_ENV=production (requires HTTPS).
# NODE_ENV=production
# COOKIE_SECURE=true
# Set to true when running behind a reverse proxy/load balancer so rate limits see the real client IP.
# TRUST_PROXY=true
