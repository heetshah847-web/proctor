# --- AI provider: set ONE key. If only GEMINI_API_KEY is set, Gemini is used automatically. ---
# Free Gemini key: https://aistudio.google.com/apikey
# Note: on Gemini's free tier Google may use what you send (questions + student answers) to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# low | medium | high | xhigh for gemini-4-hydrogen (leave empty for the model default)
GEMINI_THINKING_LEVEL=medium

# Tried in the same call when the main Gemini model is overloaded (optional, e.g. gemini-4-helium)
GEMINI_FALLBACK_MODEL=

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Local model (Ollama): runs on this machine, no quota, no outages ---
# Install https://ollama.com, then: ollama pull qwen3:8b
# Used automatically as the fallback when the cloud AI fails. AI_PROVIDER=ollama uses ONLY the local model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Order of providers for every AI call (default: the main provider, then ollama)
# AI_CHAIN=gemini,ollama

# Time limit per AI call (ms). Grading runs in the background, so students never wait on these.
GEMINI_TIMEOUT_MS=45000
CLAUDE_TIMEOUT_MS=60000
OLLAMA_TIMEOUT_MS=180000

# Every AI grading is saved here as training data for a future fine-tuned grader (empty = off).
# It contains student answers: keep it private (git-ignored).
GRADING_LOG=data/grading-log.jsonl

# Where quiz questions come from:
#   bank (default) = data/question-bank.txt, the AI only grades -> 1 AI call per attempt
#   ai             = the AI writes new questions every attempt -> 2 AI calls per attempt
QUESTION_SOURCE=bank

# Dry-run questions on the student's own code: how many per attempt (0 = off). Each one is 1 extra AI call.
CODE_QUESTIONS=1
# practice = students must paste their solution for each practice problem before the quiz; none = optional
REQUIRE_CODE=practice

# Force a provider: gemini | claude (optional)
# AI_PROVIDER=gemini

# 'demo' = templated questions + length-based grading, for trying the flow without any key
# AI_MODE=demo

# Strict proctoring
QUIZ_REQUIRE_CAMERA=true
QUIZ_MAX_STRIKES=3

PORT=3000
QUIZ_QUESTIONS=3
QUIZ_MINUTES=15
# Quiz attempts per day; 0 = unlimited (testing phase)
QUIZ_MAX_ATTEMPTS=0
QUIZ_PASS_PCT=50
# Set to true to make students wait for supervisor approval of the day's plan before the quiz (off by default while testing)
REQUIRE_SUPERVISOR_APPROVAL=false

# --- Deployment security ---
# Secure cookies + HSTS are on automatically when NODE_ENV=production (requires HTTPS).
# NODE_ENV=production
# COOKIE_SECURE=true
# Set to true when running behind a reverse proxy/load balancer so rate limits see the real client IP.
# TRUST_PROXY=true

# --- Database security ---
# Key for encrypting sensitive DB fields (64 hex chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, one is generated into data/encryption.key. In production set it here/in your host's secrets
# and back it up SEPARATELY from the database — without it, encrypted fields can't be read.
# DATA_ENCRYPTION_KEY=
# Webcam snapshots are deleted after this many days (0 = keep forever)
SNAPSHOT_RETENTION_DAYS=90

# --- Webcam object detection (browser-side, EfficientDet-Lite0 float16, runs on the CPU) ---
# Warns when a phone, book/notes, another laptop/screen or a second person is visible (needs the camera on).
# OBJECT_DETECTION=false turns it off. PHONE_ENDS_ATTEMPT=true makes a visible phone end the attempt instead of a warning.
OBJECT_DETECTION=true
PHONE_ENDS_ATTEMPT=false

# --- Gaze tracking (browser-side, MediaPipe Face Landmarker) ---
# Warns when the student keeps looking to the left or right, e.g. at a second laptop or notes placed out of
# camera view. The angle is head turn + eye turn, measured from where the student looked during the pre-quiz check.
# GAZE_DETECTION=false turns it off.
GAZE_DETECTION=true
# Further to the side than this many degrees counts as looking away (a laptop screen's edges are ~15°).
GAZE_MAX_DEG=30
# A warning after looking away this many seconds without a break...
GAZE_AWAY_SECONDS=4
# ...or after this many seconds of looking away in total within any minute (repeated short looks).
GAZE_BUDGET_SECONDS=15
